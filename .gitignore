/target/
**/target/
/dist/
/build/
*.bin
!game/title_bg.bin
*.cue
*.exe
*.iso
.worktrees/
/.opencode/

# Cargo's own lock files. `**/target/` already covers the per-target ones, so
# these only matter for a stray lock outside a target directory.
.cargo-artifact-lock
.cargo-build-lock
.cargo-lock
__pycache__/
/scratch/

# The web arcade bundle copies the mastered disc into web/roms/ for serving.
# 29 MB of game data must never be committed by accident, and the deployed
# bundle is staged from CI, not from the working tree.
/web/roms/
